# DevFlow application settings
# Copy this file once to the repository root as `.env`.
# DevFlow resolves this repository-root file independently of the current working directory.
DEVFLOW_APP_NAME=DevFlow
DEVFLOW_ENVIRONMENT=development
DEVFLOW_LOG_LEVEL=INFO
DEVFLOW_WORKSPACE_ROOT=.devflow/workspaces

# PostgreSQL durability layer. PostgreSQL persists Run/Task/dispatch/evidence truth; Git/worktree
# state remains authoritative for repository contents. Apply migrations before starting the API:
#   cd backend && alembic upgrade head
DEVFLOW_DATABASE_URL=postgresql+psycopg://devflow:devflow@127.0.0.1:5432/devflow
DEVFLOW_DATABASE_ECHO=false

# Redis/Dramatiq is transport only. Queue messages contain only dispatch_id/run_id/task_id.
DEVFLOW_REDIS_URL=redis://127.0.0.1:6379/0
DEVFLOW_DRAMATIQ_NAMESPACE=devflow
DEVFLOW_DRAMATIQ_QUEUE_NAME=devflow_tasks

# Worker ownership/liveness. PostgreSQL database time is authoritative for lease expiry. A worker
# acquires a generation-bound lease plus a server-issued run_token; stale generations are fenced
# from accepted evidence and Git mutation.
# DEVFLOW_WORKER_ID=devflow-worker-1
DEVFLOW_WORKER_LEASE_SECONDS=60
DEVFLOW_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
# Outer Dramatiq emergency ceiling. Keep this above Agent budgets so Agent TIME_LIMIT can be
# persisted before the Worker is interrupted. This covers one full task lifecycle, not a single
# model turn.
DEVFLOW_WORKER_TASK_TIME_LIMIT_SECONDS=7200
DEVFLOW_CONTINUATION_MAX_SLICES=5
DEVFLOW_CONTINUATION_TOTAL_BUDGET_SECONDS=3600
DEVFLOW_CONTINUATION_MAX_REPEATED_FILE_SLICES=1
DEVFLOW_DAG_MAX_CONCURRENT_TASKS=2
# Liveness projection and orphan-run recovery.  These values only affect the user-facing
# display state; immutable Run evidence is never rewritten.
DEVFLOW_RECOVERY_CHECK_INTERVAL_SECONDS=30
DEVFLOW_RECOVERY_STARTUP_TIMEOUT_SECONDS=120
DEVFLOW_RECOVERY_STALE_PROGRESS_SECONDS=180
# Lifecycle/recovery capability rollout: test_database -> test_repository ->
# project_allowlist -> default. Read-only diagnostics remain available in every mode.
# Set TEST_REPOSITORY_URL exactly to the repository URL approved for the trial, or set a
# comma-separated PROJECT_ALLOWLIST of DevFlow project UUIDs. Do not place credentials here.
DEVFLOW_LIFECYCLE_ROLLOUT_MODE=default
DEVFLOW_LIFECYCLE_TEST_REPOSITORY_URL=
DEVFLOW_LIFECYCLE_PROJECT_ALLOWLIST=
# Workflow rollout: workflow_only | workflow_first | agent_only
DEVFLOW_WORKFLOW_ACTIVATION_MODE=workflow_first
DEVFLOW_WORK_PACKAGE_ACTIVATION_MODE=work_package_first
DEVFLOW_WORKER_TERMINAL_PERSISTENCE_GRACE_SECONDS=180

# SiliconFlow provider. Blank means provider not configured. /readyz checks the live provider model
# catalogue and reports NOT_READY when a configured model id disappears; DevFlow never silently
# falls back to a different model.
SILICONFLOW_API_KEY=
# Standard profile for multi-step Coding Agent runs. Lower to ~30000 for economy workloads.
DEVFLOW_RUN_TOKEN_BUDGET_TOKENS=50000
# Budget and hard attempt cap for the Planner before a durable Run exists.
DEVFLOW_PLANNER_TOKEN_BUDGET_TOKENS=7200
DEVFLOW_PLANNER_MAX_ATTEMPTS=2
# One initial Plan plus one compact recovery can be budgeted before contacting the provider.
DEVFLOW_PLANNER_INITIAL_MAX_OUTPUT_TOKENS=1000
DEVFLOW_PLANNER_JSON_REPAIR_MAX_OUTPUT_TOKENS=700
DEVFLOW_PLANNER_BUDGET_REPLAN_MAX_OUTPUT_TOKENS=800
DEVFLOW_TOKEN_ESTIMATE_SAFETY_FACTOR=1.15
# Context-economy rollout controls; each can be disabled independently for a safe rollback.
DEVFLOW_CONTEXT_COMPACTION_ENABLED=true
DEVFLOW_ROLE_CONTEXT_PROJECTION_ENABLED=true
# Experimental Agent Runtime V3 rollout on xin_01. Disable any flag to fall back without
# changing Git/verification/checkpoint authority.
DEVFLOW_AGENT_RUNTIME_V3_ENABLED=true
DEVFLOW_DEVELOPER_RUNTIME_V3_ENABLED=true
DEVFLOW_REPAIR_RUNTIME_V3_ENABLED=true
DEVFLOW_RUNTIME_MUTATION_GATE_ENABLED=true
DEVFLOW_RUNTIME_IMPORT_PREFETCH_ENABLED=true
DEVFLOW_RUNTIME_REPO_MAP_ENABLED=true
# OpenHands-derived stuck-pattern detector for Agent Runtime V3.
DEVFLOW_RUNTIME_STUCK_DETECTOR_ENABLED=true
# OpenHands-derived multi-file patch parser. Disable to keep only legacy exact replacement.
DEVFLOW_OPENHANDS_PATCH_ENABLED=true
DEVFLOW_AGENT_MAX_SINGLE_TOOL_RESULT_TOKENS=1200
DEVFLOW_AGENT_MAX_TOOL_RESULTS_PER_TURN_TOKENS=2400
# Developer keeps one complete recent tool group; older observations are compacted into hashes,
# paths, symbols and bounded working-state facts rather than replaying raw source/tool payloads.
DEVFLOW_DEVELOPER_MAX_RETAINED_TOOL_GROUPS=1
DEVFLOW_DEVELOPER_MAX_SINGLE_TOOL_RESULT_TOKENS=800
DEVFLOW_DEVELOPER_MAX_TOOL_RESULTS_PER_TURN_TOKENS=1600
# Fresh Repair sessions keep only bounded observations; raw evidence remains persisted separately.
DEVFLOW_REPAIR_MAX_SINGLE_TOOL_RESULT_TOKENS=600
DEVFLOW_REPAIR_MAX_TOOL_RESULTS_PER_TURN_TOKENS=1200
DEVFLOW_ADAPTIVE_PACKAGE_BUDGET_ENABLED=true
DEVFLOW_ADAPTIVE_WORK_PACKAGE_ROUTING_ENABLED=true
DEVFLOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEVFLOW_SILICONFLOW_TIMEOUT_SECONDS=60
DEVFLOW_SILICONFLOW_MAX_RETRIES=0

# Agent execution budgets. These do not change the Worker lease heartbeat. A timed-out repair
# preserves its work, reruns deterministic verification, and may continue up to the repair budget.
DEVFLOW_DEVELOPER_MAX_ITERATIONS=12
DEVFLOW_DEVELOPER_MAX_DURATION_SECONDS=600
DEVFLOW_DEVELOPER_MAX_MODEL_TURN_SECONDS=180
# Normal Developer turns stay compact. A single malformed write_file retry may use this larger
# cap so a valid JSON payload for a source skeleton is not truncated.
DEVFLOW_DEVELOPER_INVALID_TOOL_RETRY_MAX_OUTPUT_TOKENS=3200
DEVFLOW_REPAIR_MAX_ITERATIONS=4
DEVFLOW_REPAIR_MAX_DURATION_SECONDS=300
DEVFLOW_REPAIR_MAX_MODEL_TURN_SECONDS=90
DEVFLOW_REPAIR_MAX_READ_RANGE_LINES=120
DEVFLOW_MINIMUM_REPAIR_ATTEMPTS=2

# Role-to-model configuration. Update these explicitly when provider availability changes.
DEVFLOW_PLANNER_MODEL=zai-org/GLM-5.2
DEVFLOW_DEVELOPER_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
DEVFLOW_REVIEWER_MODEL=zai-org/GLM-5.2
DEVFLOW_REPAIR_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
# On-demand AI explanation for a failed Run. It receives only bounded, redacted failure evidence.
DEVFLOW_FAILURE_EXPLANATION_MODEL=zai-org/GLM-5.2
# Explicitly disable mixed-model reasoning by default. Enable only a specific complex role when
# the additional quality is worth its Token cost.
DEVFLOW_PLANNER_ENABLE_THINKING=false
DEVFLOW_DEVELOPER_ENABLE_THINKING=false
DEVFLOW_REPAIR_ENABLE_THINKING=false
DEVFLOW_REVIEWER_ENABLE_THINKING=false
DEVFLOW_FAILURE_EXPLANATION_ENABLE_THINKING=false

# Git credentials are separate capabilities. READ is for private repository provisioning only;
# PUBLICATION is for pushing an accepted DevFlow branch and creating a Draft PR. Never place either
# token in a repository URL. The legacy DEVFLOW_GITHUB_TOKEN remains publication-only compatible.
DEVFLOW_GITHUB_READ_TOKEN=
DEVFLOW_GITHUB_PUBLICATION_TOKEN=
# DEVFLOW_GITHUB_TOKEN=
# Project registration tokens are encrypted with this local key before being stored in PostgreSQL.
# `scripts/start-dev.ps1` generates it once automatically when it is missing. Keep it unchanged:
# changing it makes previously saved project tokens unreadable.
DEVFLOW_SECRETS_ENCRYPTION_KEY=
DEVFLOW_GITHUB_PUBLICATION_TIMEOUT_SECONDS=30
DEVFLOW_GIT_CLONE_TIMEOUT_SECONDS=300

# Trusted verification bases. Dependency cache construction is a separate preparatory phase that
# may access package registries; authoritative verification remains networkless/read-only.
DEVFLOW_VERIFICATION_SANDBOX_IMAGE=devflow-verifier:py311
DEVFLOW_VERIFICATION_NODE_SANDBOX_IMAGE=devflow-verifier:node24
DEVFLOW_VERIFICATION_SANDBOX_CPUS=1.0
DEVFLOW_VERIFICATION_SANDBOX_MEMORY_MB=512
DEVFLOW_VERIFICATION_SANDBOX_PIDS_LIMIT=128
DEVFLOW_VERIFICATION_SANDBOX_TMPFS_MB=128
DEVFLOW_VERIFICATION_SANDBOX_SHM_MB=64
DEVFLOW_VERIFICATION_SANDBOX_TIMEOUT_SECONDS=60
# Dependency preflight probes the configured package registries before a Run is created. Use the
# same local Clash endpoint as startup when external registries require a proxy.
DEVFLOW_PROXY_URL=
DEVFLOW_DEPENDENCY_PYTHON_INDEX_URL=https://pypi.org/simple/
DEVFLOW_DEPENDENCY_NODE_REGISTRY_URL=https://registry.npmjs.org/
DEVFLOW_DEPENDENCY_PREFLIGHT_TIMEOUT_SECONDS=10
DEVFLOW_DEPENDENCY_PREFLIGHT_BUILD_TIMEOUT_SECONDS=60
DEVFLOW_DEPENDENCY_CACHE_MAX_BYTES=5368709120