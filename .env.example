# DevFlow application settings
DEVFLOW_APP_NAME=DevFlow
DEVFLOW_ENVIRONMENT=development
DEVFLOW_LOG_LEVEL=INFO
DEVFLOW_WORKSPACE_ROOT=.devflow/workspaces

# SiliconFlow is intentionally unused in Step 1.1.
# The key is reserved here so future provider integration never requires a committed secret.
SILICONFLOW_API_KEY=
