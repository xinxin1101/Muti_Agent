# DevFlow application settings
DEVFLOW_APP_NAME=DevFlow
DEVFLOW_ENVIRONMENT=development
DEVFLOW_LOG_LEVEL=INFO
DEVFLOW_WORKSPACE_ROOT=.devflow/workspaces

# SiliconFlow provider settings.
# Never commit a real key. Copy this file to `.env` for local development.
SILICONFLOW_API_KEY=
DEVFLOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEVFLOW_SILICONFLOW_TIMEOUT_SECONDS=60
# DevFlow owns retry policy; SDK-level retries remain disabled by default.
DEVFLOW_SILICONFLOW_MAX_RETRIES=0

# Role-to-model configuration. These are runtime configuration, not hard-coded Agent behavior.
DEVFLOW_PLANNER_MODEL=Pro/zai-org/GLM-4.7
DEVFLOW_DEVELOPER_MODEL=deepseek-ai/DeepSeek-V3.2
DEVFLOW_REVIEWER_MODEL=Pro/zai-org/GLM-4.7
DEVFLOW_REPAIR_MODEL=deepseek-ai/DeepSeek-V3.2

# Verification sandbox. Runtime verification never pulls images implicitly; build or provide the
# configured image before starting a run. Project-specific dependencies should be baked into a
# trusted project verification image rather than installed with network access during verification.
DEVFLOW_VERIFICATION_SANDBOX_IMAGE=devflow-verifier:py311
DEVFLOW_VERIFICATION_SANDBOX_CPUS=1.0
DEVFLOW_VERIFICATION_SANDBOX_MEMORY_MB=512
DEVFLOW_VERIFICATION_SANDBOX_PIDS_LIMIT=128
DEVFLOW_VERIFICATION_SANDBOX_TMPFS_MB=128
DEVFLOW_VERIFICATION_SANDBOX_SHM_MB=64
DEVFLOW_VERIFICATION_SANDBOX_TIMEOUT_SECONDS=60
