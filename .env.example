# DevFlow application settings
# Copy this file once to the repository root as `.env`.
# DevFlow resolves this repository-root file independently of the current working directory.
DEVFLOW_APP_NAME=DevFlow
DEVFLOW_ENVIRONMENT=development
DEVFLOW_LOG_LEVEL=INFO
DEVFLOW_WORKSPACE_ROOT=.devflow/workspaces

# PostgreSQL durability layer. PostgreSQL persists Run/Task/dispatch/evidence truth; Git/worktree
# state remains authoritative for repository contents. Apply migrations before starting the API:
#   cd backend && alembic upgrade head
DEVFLOW_DATABASE_URL=postgresql+psycopg://devflow:devflow@127.0.0.1:5432/devflow
DEVFLOW_DATABASE_ECHO=false

# Redis/Dramatiq is transport only. Queue messages contain only dispatch_id/run_id/task_id.
DEVFLOW_REDIS_URL=redis://127.0.0.1:6379/0
DEVFLOW_DRAMATIQ_NAMESPACE=devflow
DEVFLOW_DRAMATIQ_QUEUE_NAME=devflow_tasks

# Worker ownership/liveness. If DEVFLOW_WORKER_ID is omitted, DevFlow generates one stable identity
# for the lifetime of the worker process. PostgreSQL database time is authoritative for lease expiry.
# A worker acquires a generation-bound lease plus a server-issued run_token; stale generations are
# fenced from accepted evidence and Git mutation. Expired-owner recovery is authorized only by the
# durable reconciler/operator path. Redis delivery by itself never authorizes takeover.
# DEVFLOW_WORKER_ID=devflow-worker-1
DEVFLOW_WORKER_LEASE_SECONDS=60
DEVFLOW_WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# SiliconFlow provider settings. A blank key means "provider not configured" and is normalized to
# None; autonomous natural-language planning requires a real key.
SILICONFLOW_API_KEY=
DEVFLOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEVFLOW_SILICONFLOW_TIMEOUT_SECONDS=60
# DevFlow owns retry policy; SDK-level retries remain disabled by default.
DEVFLOW_SILICONFLOW_MAX_RETRIES=0

# Role-to-model configuration. These are runtime configuration, not hard-coded Agent behavior.
DEVFLOW_PLANNER_MODEL=Pro/zai-org/GLM-4.7
DEVFLOW_DEVELOPER_MODEL=deepseek-ai/DeepSeek-V3.2
DEVFLOW_REVIEWER_MODEL=Pro/zai-org/GLM-4.7
DEVFLOW_REPAIR_MODEL=deepseek-ai/DeepSeek-V3.2

# GitHub Draft PR publication. A blank token means publication is not configured. The token may
# publish only the server-selected accepted integration source; it never decides Run success.
# Use the minimum repository permissions needed to create the DevFlow branch and Draft Pull Request.
DEVFLOW_GITHUB_TOKEN=
DEVFLOW_GITHUB_PUBLICATION_TIMEOUT_SECONDS=30

# Verification sandbox. Runtime verification never pulls images implicitly; build or provide the
# configured image before starting a run. Project-specific dependencies should be baked into a
# trusted project verification image rather than installed with network access during verification.
DEVFLOW_VERIFICATION_SANDBOX_IMAGE=devflow-verifier:py311
DEVFLOW_VERIFICATION_SANDBOX_CPUS=1.0
DEVFLOW_VERIFICATION_SANDBOX_MEMORY_MB=512
DEVFLOW_VERIFICATION_SANDBOX_PIDS_LIMIT=128
DEVFLOW_VERIFICATION_SANDBOX_TMPFS_MB=128
DEVFLOW_VERIFICATION_SANDBOX_SHM_MB=64
DEVFLOW_VERIFICATION_SANDBOX_TIMEOUT_SECONDS=60
